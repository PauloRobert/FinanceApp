<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- "I" letter -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,38 L36,70 L42,70 L42,38 Z" />

    <!-- "F" letter -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,38 L50,70 L56,70 L56,57 L68,57 L68,52 L56,52 L56,43 L70,43 L70,38 Z" />

    <!-- Upward trend line (financial chart accent) -->
    <path
        android:pathData="M30,66 L42,60 L52,63 L62,54 L72,48 L78,42"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="66"
                android:endX="78"
                android:endY="42">
                <item android:color="#80A855F7" android:offset="0.0" />
                <item android:color="#FFC084FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrow tip on the trend line -->
    <path
        android:fillColor="#FFC084FC"
        android:pathData="M76,40 L80,42 L78,46 Z" />

    <!-- Dot at peak -->
    <path
        android:pathData="M78,42 m-3,0 a3,3 0,1 1,6 0 a3,3 0,1 1,-6 0"
        android:fillColor="#FFC084FC" />

</vector>
